{
  "name": "cybercodercrm",
  "version": "1.0.0",
  "description": "Multi-tenant CRM system for business management with employee tracking, direction-based income calculation, and monthly reports",
  "main": "backend/server.js",
  "scripts": {
    "start": "node backend/server.js",
    "dev": "nodemon backend/server.js",
    "restart": "fuser -k 3000/tcp 2>/dev/null; node backend/server.js",
    "stop": "fuser -k 3000/tcp 2>/dev/null && echo 'Server to\\'xtatildi'"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "crm",
    "multi-tenant",
    "business-management",
    "employee-tracking"
  ],
  "author": "Jahonsher",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "exceljs": "^4.4.0",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.1",
    "multer": "^1.4.5-lts.1",
    "xss-clean": "^0.1.4"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
